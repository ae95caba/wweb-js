// Helper para mostrar el carrito
function renderCart(cart) {
  if (!cart || cart.length === 0) return "🛒 *Tu carrito está vacío.*";

  let msg = "🛒 *Tu carrito actual:*\n";
  let totalGeneral = 0;

  cart.forEach((item, i) => {
    const price = item["totalPrice"] || item.price;
    const precioBase = item.price;
    totalGeneral += price;

    msg += `${numberToEmoji(i + 1)} *${item.name.toUpperCase()}*\n`;

    // Mostrar cantidad si existe
    if (item.quantity && item.quantity > 1) {
      msg += `   🔢 Cantidad: ${item.quantity}\n`;
      msg += `   💲Precio unitario: $${precioBase}\n`;
      msg += `   💲Total: $${price}`;
    } else {
      msg += `   💲Precio: $${precioBase}`;
    }

    if (item.flavours && item.flavours.length > 0) {
      msg += `\n   🍦 Sabores: ${item.flavours.join(", ")}`;
    }

    if (item["addOns"] && item["addOns"].length > 0) {
      msg += `\n   🍫 Aderezos:`;
      // Mostrar detalles de cada add-on
      const addOnsArr = item["addOns"];
      const addOnsData = item.selectedAddOnsData || [];
      addOnsArr.forEach((name, idx) => {
        // Buscar si hay info de cantidad y sabor de salsa
        const data = addOnsData.find(
          (a) => a && (a.name === name || a.displayName === name)
        );
        if (data) {
          let addOnDisplay = `\n     - ${name}`;
          if (data.sauceFlavour) {
            addOnDisplay += ` (${data.sauceFlavour})`;
          }
          if (data.quantity && data.quantity > 1) {
            addOnDisplay += ` x${data.quantity} ($${data.price}) = $${
              data.price * data.quantity
            }`;
          } else {
            addOnDisplay += ` ($${data.price})`;
          }
          msg += addOnDisplay;
        } else {
          msg += `\n     - ${name}`;
        }
      });

      if (item["addOnsPrice"] && item["addOnsPrice"] > 0) {
        msg += `\n   💲Total aderezos: +$${item["addOnsPrice"]}`;
      }
    }

    if (item["totalPrice"] && item["totalPrice"] !== item.price) {
      msg += `\n   💲Total  producto: $${item["totalPrice"]}`;
    }

    msg += "\n";
  });

  msg += `\n💰 *TOTAL GENERAL: $${totalGeneral}*`;
  return msg;
}

// Función para mostrar confirmación final del helado con add-ons
async function showIceCreamConfirmation(userId) {
  const availableProducts = userStates[userId].availableProducts;
  const selectedProduct = availableProducts.find(
    (p) => p._id === userStates[userId].selectedProductId
  );
  const confirmedFlavours = userStates[userId].confirmedFlavours || [];
  const selectedAddOns = userStates[userId].selectedAddOns || [];

  // Crear el item del carrito
  const cartItem = {
    name: selectedProduct.name,
    price: selectedProduct.price,
    _id: selectedProduct._id,
    flavours: confirmedFlavours,
  };

  // Agregar add-ons si existen
  if (selectedAddOns.length > 0) {
    cartItem["addOns"] = selectedAddOns.map((a) => {
      // Si tiene sabor de salsa, usar el displayName, sino usar el nombre normal
      return a.displayName || a.name;
    });
    cartItem["addOnsPrice"] = selectedAddOns.reduce(
      (sum, a) => sum + a.price * (a.quantity || 1),
      0
    );
    cartItem["totalPrice"] = selectedProduct.price + cartItem["addOnsPrice"];
    cartItem["selectedAddOnsData"] = selectedAddOns.map((a) => {
      // Asegurar que se guarde toda la información del add-on incluyendo precio
      return {
        name: a.displayName || a.name,
        price: a.price,
        quantity: a.quantity || 1,
        sauceFlavour: a.sauceFlavour,
        _id: a._id,
      };
    });
  }

  userStates[userId].cart.push(cartItem);
  userStates[userId].state = "show-flavour-confirmation";
  // Limpiar add-ons seleccionados para el próximo producto
  userStates[userId].selectedAddOns = [];

  return `${renderCart(
    userStates[userId].cart
  )}\n\n¿Quieres agregar otro producto?\n\nResponde con *sí* o *no*`;
}

// Formatea la descripción: primera letra mayúscula, salto de línea tras cada punto y al final
function formatDescription(desc) {
  if (!desc || typeof desc !== "string") return "";
  let trimmed = desc.trim();
  if (trimmed.length === 0) return "";
  // Primera letra en mayúscula
  trimmed = trimmed.charAt(0).toUpperCase() + trimmed.slice(1);
  // Salto de línea después de cada punto (seguido o no de espacio)
  trimmed = trimmed.replace(/\.(\s+|$)/g, ".\n");
  // Si no termina en punto, agregar salto de línea al final
  if (!trimmed.endsWith(".\n")) trimmed += "\n";
  return trimmed;
}

// Utilidad para mensaje de cantidad de producto o add-on
function getQuantityPrompt({ name, description, price, isAddon = false }) {
  return `🔢 *¿Cuántos* ${name.toUpperCase()} *quieres agregar?*\n\n${
    description ? formatDescription(description) + "\n" : ""
  }💲Precio unitario: $${price}\n\nPor favor, ingresa un número (por ejemplo: 2).\n\n*Escribe 0 para cancelar y volver al menú${
    isAddon ? " de toppings" : ""
  }.*`;
}

// Utilidad para mensaje de confirmación de add-on
function getAddOnConfirmationPrompt({
  name,
  price,
  quantity = null,
  sauceFlavour = null,
}) {
  let prompt = `🍫 *Add-on seleccionado:* ${name.toUpperCase()}\n`;

  if (sauceFlavour) {
    prompt += `🍯 Sabor: ${sauceFlavour}\n`;
  }

  if (quantity && quantity > 1) {
    prompt += `Cantidad: ${quantity}\n💲Precio unitario: $${price}\n💲Total: $${
      price * quantity
    }\n`;
  } else {
    prompt += `💲Precio: $${price}\n`;
  }

  prompt += `\n¿Confirmas este aderezo?\n\nResponde con *sí* o *no*`;
  return prompt;
}

// Función principal para manejar mensajes del bot
async function handleBotMessage(message) {
  const userId = message.from;
  const userMessage = message.body ? message.body.toLowerCase().trim() : "";

  // Inicializar estado del usuario si no existe
  if (!userStates[userId]) {
    userStates[userId] = { state: "menu" };
  }
  // Inicializar carrito si no existe
  if (!userStates[userId].cart) userStates[userId].cart = [];

  // Verificar si el usuario está usando comandos de testing
  if (userMessage === "test_horario_on") {
    userStates[userId].testMode = true;
    console.log(`[BOT] Usuario ${userId} activó modo test`);
    return `✅ *Modo test activado*\n\n🕐 Verificación de horarios desactivada\n\nPuedes usar el bot normalmente sin restricciones de horario.\n\nPara desactivar el modo test, escribe "test_horario_off"`;
  }

  if (userMessage === "test_horario_off") {
    userStates[userId].testMode = false;
    console.log(`[BOT] Usuario ${userId} desactivó modo test`);
    console.log(`[BOT] Estado actual del usuario:`, userStates[userId]);
    return `❌ *Modo test desactivado*\n\n🕐 Verificación de horarios reactivada\n\nAhora el bot respetará los horarios de atención normales.\n\nEstado actual: testMode = ${userStates[userId].testMode}`;
  }

  // Verificar horarios de atención al inicio (excepto si está en modo test)
  if (!userStates[userId].testMode && !isBusinessHours()) {
    console.log(
      `[BOT] Usuario ${userId} intentó hacer un pedido fuera de horario`
    );
    console.log(
      `[BOT] testMode: ${
        userStates[userId].testMode
      }, isBusinessHours: ${isBusinessHours()}`
    );
    return getOutOfHoursMessage();
  }

  // Si el usuario está en modo persona real, no responder
  if (usersWithHumanSupport.has(userId)) return;

  // LOG: Estado actual y mensaje recibido
  console.log(
    `[BOT] Estado actual: ${userStates[userId].state}, Mensaje: '${userMessage}'`
  );

  // Mostrar menú principal si el usuario escribe "menu", "hola" o "inicio"
  if (["menu", "hola", "inicio"].includes(userMessage)) {
    userStates[userId] = {
      state: "menu",
      testMode: userStates[userId].testMode,
    };
    const { menu, availableProducts } = await getMainMenu();
    userStates[userId].availableProducts = availableProducts;
    console.log(`[BOT] Transición a estado: menu`);
    return menu;
  }

  // Comando especial para desactivar el bot por 1 hora en el chat actual
  if (userMessage === "/kill_bot") {
    return "🤖 El bot ha sido desactivado en este chat temporalmente.";
  }

  // Menú principal dinámico
  if (userStates[userId].state === "menu") {
    console.log(`[BOT] Procesando menú principal, mensaje: '${userMessage}'`);
    const availableProducts = userStates[userId].availableProducts;
    console.log(
      `[BOT] Productos disponibles:`,
      availableProducts ? availableProducts.length : "undefined"
    );

    if (!availableProducts) {
      const { menu, availableProducts: products } = await getMainMenu();
      userStates[userId].availableProducts = products;
      console.log(`[BOT] Sin productos en estado, mostrando menú principal`);
      return menu;
    }

    const option = parseInt(userMessage, 10);
    console.log(`[BOT] Opción parseada: ${option}, esNaN: ${isNaN(option)}`);
    console.log(`[BOT] Rango válido: 0 a ${availableProducts.length + 1}`);

    if (isNaN(option) || option < 0 || option > availableProducts.length + 1) {
      const { menu, availableProducts: products } = await getMainMenu({
        allowCancelAddProduct: false,
      });
      console.log(`[BOT] Opción inválida en menú principal: ${option}`);

      // Crear menú simplificado sin la introducción para opciones inválidas
      const menuLines = menu.split("\n");
      const startIndex = menuLines.findIndex((line) =>
        line.includes("─────────────")
      );
      const simplifiedMenu = menuLines.slice(startIndex).join("\n");

      return `❌ Por favor, selecciona una opción válida.\n\n${simplifiedMenu}`;
    }

    console.log(`[BOT] Opción válida seleccionada: ${option}`);

    if (option === 0) {
      usersWithHumanSupport.add(userId);
      userStates[userId] = {
        state: "human_support",
        testMode: userStates[userId].testMode,
      };
      return `👨‍💼 *Conectando con una persona real...*\n\n✅ *Bot desactivado para esta conversación*\n\nUn representante se pondrá en contacto contigo pronto. Mientras tanto, puedes escribir libremente y serás atendido por una persona real.`;
    }

    const selectedProduct = availableProducts[option - 1];
    console.log(`[BOT] Producto seleccionado:`, selectedProduct);
    userStates[userId].selectedProductId = selectedProduct._id;
    // Si es frozen-treat, saltar confirmación y pedir cantidad directamente
    if (selectedProduct.type === "frozen-treat" && !selectedProduct.apiRoute) {
      userStates[userId].state = "ask-frozen-treat-quantity";
      console.log(
        `[BOT] Transición directa a estado: ask-frozen-treat-quantity (sin confirmación)`
      );
      return getQuantityPrompt({
        name: selectedProduct.name,
        description: selectedProduct.description,
        price: selectedProduct.price,
        isAddon: false,
      });
    }
    // Mostrar confirmación del producto para los demás casos
    userStates[userId].state = "confirm-product";
    console.log(`[BOT] Transición a estado: confirm-product`);
    return `🍰 *${selectedProduct.name.toUpperCase()}*\n\n${
      selectedProduct.description ? selectedProduct.description + "\n\n" : ""
    }💲Precio: $${
      selectedProduct.price
    }\n\n¿Confirmas este producto?\n\nResponde con *sí* o *no*`;
  }

  // Confirmación de producto seleccionado
  if (userStates[userId].state === "confirm-product") {
    if (userMessage === "1" || userMessage === "sí" || userMessage === "si") {
      const availableProducts = userStates[userId].availableProducts;
      const selectedProduct = availableProducts.find(
        (p) => p._id === userStates[userId].selectedProductId
      );
      if (selectedProduct.type === "ice-cream") {
        userStates[userId].state = "ice-cream-flavour";
        userStates[userId].maxFlavours = selectedProduct.flavours || 1;
        const { menu, availableFlavours } = await getFlavourMenu(
          userStates[userId].maxFlavours
        );
        userStates[userId].availableFlavours = availableFlavours;
        console.log(
          `[BOT] Transición a estado: ice-cream-flavour (maxFlavours: ${userStates[userId].maxFlavours})`
        );
        return menu;
      } else if (
        selectedProduct.type === "frozen-treat" &&
        !selectedProduct.apiRoute
      ) {
        // Productos frozen-treat sin apiRoute necesitan selección de cantidad
        userStates[userId].state = "ask-frozen-treat-quantity";
        console.log(`[BOT] Transición a estado: ask-frozen-treat-quantity`);
        return getQuantityPrompt({
          name: selectedProduct.name,
          description: selectedProduct.description,
          price: selectedProduct.price,
          isAddon: false,
        });
      } else {
        // Agregar producto al carrito directamente
        userStates[userId].cart.push({
          name: selectedProduct.name,
          price: selectedProduct.price,
          _id: selectedProduct._id,
        });
        userStates[userId].state = "show-product-info";
        console.log(`[BOT] Transición a estado: show-product-info`);
        return `${renderCart(
          userStates[userId].cart
        )}\n\n¿Quieres agregar otro producto?\n1️⃣ Sí\n2️⃣ No`;
      }
    } else if (userMessage === "2" || userMessage === "no") {
      // Preservar el carrito y solo cambiar el estado
      userStates[userId].state = "menu";
      const { menu, availableProducts: newProducts } = await getMainMenu();
      userStates[userId].availableProducts = newProducts;
      console.log(`[BOT] Transición a estado: menu (producto no confirmado)`);
      return menu;
    } else {
      const availableProducts = userStates[userId].availableProducts;
      const selectedProduct = availableProducts.find(
        (p) => p._id === userStates[userId].selectedProductId
      );
      console.log(`[BOT] Respuesta inválida en confirm-product`);
      return `Por favor responde con *sí* o *no*.\n\n🍰 *${selectedProduct.name.toUpperCase()}*\n\n$${
        selectedProduct.description ? selectedProduct.description + "\n\n" : ""
      }💲Precio: $${
        selectedProduct.price
      }\n\n¿Confirmas este producto?\n\nResponde con *sí* o *no*`;
    }
  }

  // Menú de sabores de helado (selección múltiple y confirmación)
  if (userStates[userId].state === "ice-cream-flavour") {
    const availableFlavours = userStates[userId].availableFlavours;
    const maxFlavours = userStates[userId].maxFlavours || 1;
    const confirmedFlavours = userStates[userId].confirmedFlavours || [];
    const selectedOptions = userMessage
      .split(/[\,\s]+/)
      .map((x) => parseInt(x, 10))
      .filter((x) => !isNaN(x));
    // Validar que no se repitan sabores ya confirmados
    const invalid =
      !availableFlavours ||
      selectedOptions.length === 0 ||
      selectedOptions.some(
        (opt) =>
          opt < 1 ||
          opt > availableFlavours.length ||
          confirmedFlavours.includes(availableFlavours[opt - 1].name)
      ) ||
      selectedOptions.length + confirmedFlavours.length > maxFlavours;
    if (invalid) {
      let menu = `❌ Selección inválida.\n\n🍦 *Elige hasta ${
        maxFlavours - confirmedFlavours.length
      } sabor(es):*\n\n`;
      if (confirmedFlavours.length > 0) {
        menu += `*Sabores elegidos:* ${confirmedFlavours.join(", ")}\n\n`;
      }
      availableFlavours.forEach((f, i) => {
        if (!confirmedFlavours.includes(f.name)) {
          menu += `${numberToEmoji(i + 1)} *${f.name}*\n`;
        }
      });
      menu += `\n💡 *Puedes elegir múltiples sabores de una vez*\n`;
      menu += `📝 *Ejemplo: 1 3 5* (para elegir los sabores 1, 3 y 5)`;
      return menu;
    }
    userStates[userId].pendingFlavours = selectedOptions;
    // Mostrar solo los sabores pendientes en la confirmación
    const pendingFlavoursNames = selectedOptions.map(
      (opt) => availableFlavours[opt - 1].name
    );
    userStates[userId].state = "confirm-flavours";
    console.log(
      `[BOT] Transición a estado: confirm-flavours (sabores: ${pendingFlavoursNames.join(
        ", "
      )})`
    );
    return `🍦 *Sabores elegidos:* ${confirmedFlavours.join(
      ", "
    )}\n\n*Los sabores que elegiste ahora son:* ${pendingFlavoursNames.join(
      ", "
    )}\n\n¿Es correcto?\n\nResponde con *sí* o *no*`;
  }

  // Confirmación de sabores
  if (userStates[userId].state === "confirm-flavours") {
    console.log(`[BOT] En estado confirm-flavours, mensaje: '${userMessage}'`);
    const availableFlavours = userStates[userId].availableFlavours;
    const maxFlavours = userStates[userId].maxFlavours || 1;
    const selectedOptions = userStates[userId].pendingFlavours || [];
    const pendingFlavoursNames = selectedOptions.map(
      (opt) => availableFlavours[opt - 1].name
