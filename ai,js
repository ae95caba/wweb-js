// Estado de usuarios simplificado
// { [userId]: { lastWelcomeDate: string } }
const userStates = {};

// Función para verificar si estamos en horario de atención
function isBusinessHours() {
  const now = new Date();
  const currentHour = now.getHours();
  const currentDay = now.getDay(); // 0 = Domingo, 1 = Lunes, ..., 6 = Sábado

  // Horarios de atención:
  // Lunes a Viernes: 20:00 - 24:00
  // Sábados, Domingos y Feriados: 13:00 - 01:00 del día siguiente

  const isWeekday = currentDay >= 1 && currentDay <= 5; // Lunes a Viernes
  const isWeekend = currentDay === 0 || currentDay === 6; // Domingo o Sábado

  if (isWeekday) {
    // Lunes a Viernes: 20:00 - 24:00
    return currentHour >= 20 && currentHour < 24;
  } else if (isWeekend) {
    // Sábados y Domingos: 13:00 - 01:00 del día siguiente
    return currentHour >= 13 || currentHour < 1;
  }

  return false;
}

function getWelcomeMessage() {
  return "👋 ¡Hola! Gracias por escribirnos.\n\nEn breve nos pondremos en contacto contigo.";
}

async function shouldIgnoreMessage(message) {
  const userId = message.from;

  // Ignorar mensajes enviados por el propio bot
  if (message._data.id.fromMe) return true;

  // Obtener información del chat
  let chat;
  try {
    chat = await message.getChat();
  } catch (e) {
    return false;
  }

  // Ignorar grupos, estados, etc.
  if (chat.isGroup) return true;
  if (message.from === "status@broadcast") return true;
  if (message.type === "e2e_notification") return true;

  // 1. Verificar Horario de Atención
  if (!isBusinessHours()) {
    console.log(`[BOT] Mensaje fuera de horario de atención: ${userId}`);
    return true; // Ignorar si está fuera de horario
  }

  // 2. Verificar "Una vez por día"
  const today = new Date().toDateString();
  const userState = userStates[userId];

  if (userState && userState.lastWelcomeDate === today) {
    console.log(`[BOT] Usuario ${userId} ya recibió bienvenida hoy (${today})`);
    return true; // Ignorar si ya saludamos hoy
  }

  // Si pasa todas las verificaciones, NO ignorar (responderemos)
  return false;
}

async function handleBotMessage(message) {
  const userId = message.from;
  const today = new Date().toDateString();

  // Actualizar estado
  if (!userStates[userId]) {
    userStates[userId] = {};
  }
  userStates[userId].lastWelcomeDate = today;

  console.log(`[BOT] Enviando bienvenida a ${userId}`);
  return getWelcomeMessage();
}

// Stats simplificados
function getBotStats() {
  return {
    totalUsers: Object.keys(userStates).length,
    activeToday: Object.values(userStates).filter(u => u.lastWelcomeDate === new Date().toDateString()).length
  };
}

module.exports = {
  shouldIgnoreMessage,
  handleBotMessage,
  getBotStats,
  userStates
};
